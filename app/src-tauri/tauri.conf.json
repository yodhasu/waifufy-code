{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waifufy Code",
  "version": "0.1.1",
  "identifier": "ai.waifufy.code",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Waifufy Code",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "backgroundColor": "#05070f",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' data: blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "worker-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Waifufy",
    "shortDescription": "Claude Code as a visual novel",
    "longDescription": "Claude Code, reskinned as a visual novel: a Live2D waifu is your coding agent.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
